{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/miohansen/ready-to-release/schemas/agent-result.json",
  "title": "Agent Result",
  "description": "Standardized output format for all Claude Code agents",
  "type": "object",
  "required": ["agent", "task", "status", "timestamp"],
  "properties": {
    "agent": {
      "type": "string",
      "description": "Name of the agent that produced this result",
      "enum": [
        "go-architect",
        "go-cli-ux",
        "go-test-engineer",
        "go-debugger",
        "go-security-release",
        "go-workflow-engineer"
      ]
    },
    "task": {
      "type": "string",
      "description": "Brief description of the task performed"
    },
    "status": {
      "type": "string",
      "description": "Overall status of the task execution",
      "enum": ["success", "warning", "error"]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 timestamp when the result was generated"
    },
    "findings": {
      "type": "array",
      "description": "List of findings or observations from the agent",
      "items": {
        "type": "object",
        "required": ["severity", "category", "message"],
        "properties": {
          "severity": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low", "info"],
            "description": "Severity level of the finding"
          },
          "category": {
            "type": "string",
            "enum": [
              "security",
              "performance",
              "style",
              "correctness",
              "testing",
              "architecture",
              "ux",
              "documentation"
            ],
            "description": "Category of the finding"
          },
          "location": {
            "type": "string",
            "description": "Location in code (e.g., 'file.go:123' or 'module/package')"
          },
          "message": {
            "type": "string",
            "description": "Human-readable description of the finding"
          },
          "recommendation": {
            "type": "string",
            "description": "Suggested fix or improvement"
          },
          "code_snippet": {
            "type": "string",
            "description": "Relevant code snippet (optional)"
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "description": "Quantitative metrics about the analysis",
      "properties": {
        "duration_seconds": {
          "type": "number",
          "description": "Time taken to complete the task"
        },
        "items_analyzed": {
          "type": "integer",
          "description": "Number of items (files, tests, modules, etc.) analyzed"
        },
        "findings_by_severity": {
          "type": "object",
          "properties": {
            "critical": { "type": "integer" },
            "high": { "type": "integer" },
            "medium": { "type": "integer" },
            "low": { "type": "integer" },
            "info": { "type": "integer" }
          }
        }
      }
    },
    "summary": {
      "type": "string",
      "description": "Human-readable summary of the analysis and key takeaways"
    },
    "next_steps": {
      "type": "array",
      "description": "Recommended next steps or actions",
      "items": {
        "type": "string"
      }
    },
    "artifacts": {
      "type": "array",
      "description": "Generated artifacts (files, reports, etc.)",
      "items": {
        "type": "object",
        "required": ["path", "type"],
        "properties": {
          "path": {
            "type": "string",
            "description": "Path to the artifact file"
          },
          "type": {
            "type": "string",
            "enum": ["plan", "test", "implementation", "report", "documentation"],
            "description": "Type of artifact"
          },
          "description": {
            "type": "string",
            "description": "Brief description of the artifact"
          }
        }
      }
    }
  }
}
