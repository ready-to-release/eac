{
  "env": {},
  "enableAllProjectMcpServers": true,
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": ["Bash(git status:*)", "Bash(git log:*)"],
    "ask": [],
    "deny": []
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'f=$(jq -r \".tool_input.file_path // empty\"); [[ \"$f\" == *.go ]] && gofmt -w \"$f\" || true'"
          }
        ]
      }
    ]
  },
  "cleanupPeriodDays": 99999
}
