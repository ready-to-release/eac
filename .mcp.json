{
  "mcpServers": {
    "commands": {
      "type": "stdio",
      "command": "go",
      "args": [
        "run",
        "./src/mcp/commands/main.go"
      ],
      "env": {}
    },
    "github": {
      "type": "stdio",
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "ghcr.io/github/github-mcp-server:v0.21.0"
      ],
      "env": {}
    }
  }
}