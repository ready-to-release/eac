{
  "mcpServers": {
    "commands": {
      "type": "stdio",
      "command": "go",
      "args": [
        "run",
        "./go/mcp/commands"
      ],
      "env": {
        "EAC_USE_DIRECT_BINARY": "true"
      }
    },
    "github": {
      "type": "stdio",
      "command": "docker",
      "args": [
        "run", "-i", "--rm",
        "-e", "GITHUB_PERSONAL_ACCESS_TOKEN",
        "ghcr.io/github/github-mcp-server"
      ],
      "env": {}
    }
  }
}
