{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ready-to-release.org/schemas/eac-core/tool-config/0.1.0",
  "title": "Tool Configuration Schema",
  "description": "Schema for pluggable tool composition configuration. Defines tools, their assignments to component types, and environment-specific overrides.",
  "type": "object",
  "properties": {
    "tools": {
      "type": "object",
      "description": "Map of tool ID to tool definition. Tool IDs should be lowercase with hyphens.",
      "additionalProperties": {
        "$ref": "#/$defs/tool_definition"
      }
    },
    "component-tools": {
      "type": "object",
      "description": "Map of component type to tool assignments. Component types match those in blueprints.yml component-kinds.",
      "additionalProperties": {
        "$ref": "#/$defs/tool_assignment"
      }
    },
    "environments": {
      "type": "object",
      "description": "Environment-specific tool overrides. Common environments: 'ci', 'local'.",
      "additionalProperties": {
        "$ref": "#/$defs/environment_config"
      }
    },
    "caches": {
      "type": "object",
      "description": "Named cache directories for tool execution.",
      "additionalProperties": {
        "$ref": "#/$defs/cache_config"
      }
    }
  },
  "$defs": {
    "tool_definition": {
      "type": "object",
      "description": "A tool that can be executed for build, lint, scan, test, or serve operations.",
      "required": ["type"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique tool identifier. If omitted, uses the map key.",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "description": {
          "type": "string",
          "description": "Human-readable description of what this tool does."
        },
        "type": {
          "type": "string",
          "enum": ["system", "container"],
          "description": "Execution type: 'system' for local binaries, 'container' for Docker."
        },
        "binary": {
          "type": "string",
          "description": "Binary name or path (for type: system). Must be in PATH or absolute path.",
          "examples": ["go", "npm", "/usr/local/bin/golangci-lint"]
        },
        "args": {
          "type": "array",
          "description": "Default arguments for system binary. Supports placeholders: {workspace}, {module}, {output}.",
          "items": { "type": "string" }
        },
        "localPath": {
          "type": "string",
          "description": "Path to local container build context (e.g., 'containers/mkdocs-site'). When set, the container is built from Dockerfile in devbox and pulled from GHCR in CI.",
          "examples": ["containers/mkdocs-site", "containers/drawio-oci"]
        },
        "image": {
          "type": "string",
          "description": "Docker image name for external containers. Example: 'ghcr.io/aquasecurity/trivy'. External containers require pinned version tags.",
          "pattern": "^[a-z0-9][a-z0-9._/-]*$"
        },
        "tag": {
          "type": "string",
          "description": "Docker image tag. External containers must use explicit version tags (not 'latest', 'dev', etc.).",
          "examples": ["0.50.1", "v2.1.0", "1.62.2"]
        },
        "container": {
          "type": "string",
          "description": "Reference to container defined in repository.yml containers section (legacy, prefer localPath).",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "command": {
          "type": "array",
          "description": "Container command (CMD). Supports placeholders.",
          "items": { "type": "string" }
        },
        "entrypoint": {
          "type": "array",
          "description": "Container entrypoint override.",
          "items": { "type": "string" }
        },
        "env": {
          "type": "object",
          "description": "Environment variables. Values support placeholders.",
          "additionalProperties": { "type": "string" }
        },
        "workdir": {
          "type": "string",
          "description": "Working directory. Supports placeholders like {module}."
        },
        "mounts": {
          "type": "array",
          "description": "Volume mounts for container tools.",
          "items": { "$ref": "#/$defs/mount_config" }
        },
        "network": {
          "type": "string",
          "description": "Docker network mode.",
          "examples": ["host", "bridge", "none"]
        },
        "user": {
          "type": "string",
          "description": "Container user (UID:GID or username).",
          "examples": ["1000:1000", "node"]
        },
        "privileged": {
          "type": "boolean",
          "description": "Run container in privileged mode. Use with caution.",
          "default": false
        },
        "resources": {
          "$ref": "#/$defs/resources_config",
          "description": "Resource requirements for scheduling and container limits."
        },
        "requirements": {
          "type": "array",
          "description": "Other tools required to run this tool (e.g., container tools require 'docker').",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        },
        "platforms": {
          "type": "array",
          "description": "Platforms where this tool is available. Empty means all platforms.",
          "items": {
            "type": "string",
            "enum": ["linux", "darwin", "windows"]
          },
          "examples": [["linux", "darwin"], ["windows"], ["linux", "darwin", "windows"]]
        },
        "verify": {
          "$ref": "#/$defs/verify_config",
          "description": "Verification configuration for checking tool availability."
        },
        "version": {
          "type": "string",
          "description": "Required version constraint (e.g., '>=1.21', '>=20.10').",
          "examples": [">=1.21", ">=20.10", ">=2.0"]
        },
        "output_format": {
          "type": "string",
          "enum": ["json", "text", "stream"],
          "description": "How tool output should be captured and parsed."
        },
        "serve": {
          "$ref": "#/$defs/serve_config",
          "description": "Serve-specific configuration for development servers."
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "system" } } },
          "then": { "required": ["binary"] }
        },
        {
          "if": { "properties": { "type": { "const": "container" } } },
          "then": {
            "anyOf": [
              { "required": ["localPath"] },
              { "required": ["image"] },
              { "required": ["container"] }
            ]
          }
        }
      ]
    },
    "mount_config": {
      "type": "object",
      "description": "Volume mount configuration for container tools.",
      "required": ["source", "target"],
      "properties": {
        "source": {
          "type": "string",
          "description": "Host path or placeholder ({workspace}, {module}, {output})."
        },
        "target": {
          "type": "string",
          "description": "Container path."
        },
        "readonly": {
          "type": "boolean",
          "description": "Mount as read-only.",
          "default": false
        },
        "type": {
          "type": "string",
          "enum": ["bind", "volume", "tmpfs"],
          "description": "Mount type.",
          "default": "bind"
        }
      }
    },
    "serve_config": {
      "type": "object",
      "description": "Configuration for serve (development server) operations.",
      "properties": {
        "container_port": {
          "type": "integer",
          "description": "Port inside the container.",
          "minimum": 1,
          "maximum": 65535
        },
        "host_port_range": {
          "type": "string",
          "description": "Range of ports to try on host (e.g., '9000-9999').",
          "pattern": "^[0-9]+-[0-9]+$"
        },
        "host_port_fixed": {
          "type": "integer",
          "description": "Fixed host port. 0 = auto-assign.",
          "minimum": 0,
          "maximum": 65535
        },
        "watch_enabled": {
          "type": "boolean",
          "description": "Enable file watching for live reload.",
          "default": false
        },
        "watch_paths": {
          "type": "array",
          "description": "Paths to watch for changes.",
          "items": { "type": "string" }
        },
        "watch_exclude": {
          "type": "array",
          "description": "Paths to exclude from watching.",
          "items": { "type": "string" }
        },
        "livereload_url": {
          "type": "string",
          "description": "LiveReload websocket URL."
        },
        "restart_policy": {
          "type": "string",
          "enum": ["unless-stopped", "always", "no"],
          "default": "unless-stopped"
        },
        "healthcheck_url": {
          "type": "string",
          "description": "Health check endpoint path."
        },
        "startup_delay": {
          "type": "string",
          "description": "Delay before health checks (e.g., '5s', '1m').",
          "pattern": "^[0-9]+(s|m|ms)$"
        },
        "stop_timeout": {
          "type": "string",
          "description": "Timeout for graceful shutdown.",
          "pattern": "^[0-9]+(s|m|ms)$"
        },
        "auto_open_browser": {
          "type": "boolean",
          "description": "Automatically open browser on start.",
          "default": false
        },
        "browser_path": {
          "type": "string",
          "description": "URL path to open in browser.",
          "default": "/"
        }
      }
    },
    "tool_assignment": {
      "type": "object",
      "description": "Maps operations to tool IDs for a component type.",
      "properties": {
        "builder": {
          "type": "string",
          "description": "Tool ID for build operations.",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "linter": {
          "type": "string",
          "description": "Primary tool ID for lint operations.",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "linters": {
          "type": "array",
          "description": "Multiple linter tool IDs (run in order).",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        },
        "scanner": {
          "type": "string",
          "description": "Primary tool ID for scan operations.",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "scanners": {
          "type": "array",
          "description": "Multiple scanner tool IDs.",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        },
        "tester": {
          "type": "string",
          "description": "Tool ID for test operations.",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "server": {
          "type": "string",
          "description": "Primary tool ID for serve operations.",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "servers": {
          "type": "array",
          "description": "Multiple server tool IDs.",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        }
      }
    },
    "environment_config": {
      "type": "object",
      "description": "Environment-specific configuration overrides.",
      "properties": {
        "description": {
          "type": "string",
          "description": "Description of this environment."
        },
        "component-tools": {
          "type": "object",
          "description": "Component type to tool assignment overrides.",
          "additionalProperties": {
            "$ref": "#/$defs/tool_assignment"
          }
        }
      }
    },
    "cache_config": {
      "type": "object",
      "description": "Named cache directory configuration.",
      "required": ["path"],
      "properties": {
        "path": {
          "type": "string",
          "description": "Path to cache directory. Supports placeholders."
        },
        "description": {
          "type": "string",
          "description": "Description of what this cache is for."
        }
      }
    },
    "verify_config": {
      "type": "object",
      "description": "Configuration for verifying tool availability.",
      "properties": {
        "command": {
          "type": "string",
          "description": "Command to run for verification (e.g., 'go version').",
          "examples": ["go version", "docker info", "npm --version"]
        },
        "pattern": {
          "type": "string",
          "description": "Regex pattern to extract version from command output. Use capture group for version.",
          "examples": ["go version go([0-9]+\\.[0-9]+)", "Server Version: ([0-9]+\\.[0-9]+)"]
        },
        "env_vars": {
          "type": "array",
          "description": "Environment variables to check for verification (alternative to command).",
          "items": { "type": "string" },
          "examples": [["GITHUB_TOKEN"], ["GITHUB_TOKEN", "GITHUB_USERNAME"]]
        },
        "require": {
          "type": "string",
          "enum": ["any", "all"],
          "description": "Whether any or all env_vars must be set.",
          "default": "any"
        }
      }
    },
    "resources_config": {
      "type": "object",
      "description": "Resource requirements for tool execution. CPUs value is used as scheduling weight.",
      "properties": {
        "cpus": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of CPUs. Used as scheduling weight and passed to container runtime."
        },
        "memory": {
          "type": "string",
          "pattern": "^[0-9]+[gmGM]$",
          "description": "Memory limit (e.g., '4g', '512m'). Passed to container runtime as --memory."
        },
        "shm_size": {
          "type": "string",
          "pattern": "^[0-9]+[gmGM]$",
          "description": "Shared memory size for Chromium-based tools (e.g., '2g'). Passed as --shm-size."
        }
      }
    }
  }
}
