{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ready-to-release.org/schemas/eac-core/blueprints/0.1.0",
  "title": "Blueprints Configuration Schema",
  "description": "Schema for blueprints configuration. Defines component kinds and artifact matrices as reusable building blocks for module definitions.",
  "type": "object",
  "properties": {
    "component-kinds": {
      "type": "object",
      "description": "Map of kind name to component type definition. Kinds define tool bindings, file patterns, and resource hints for each component type.",
      "additionalProperties": {
        "$ref": "#/$defs/component_kind"
      }
    },
    "artifact-matrices": {
      "type": "object",
      "description": "Map of matrix name to artifact matrix definition. Reusable artifact configurations that can be referenced by modules.",
      "additionalProperties": {
        "$ref": "#/$defs/artifact_matrix"
      }
    }
  },
  "$defs": {
    "component_kind": {
      "type": "object",
      "description": "A component type definition with tool bindings, file patterns, and resource hints.",
      "properties": {
        "name_pattern": {
          "type": "string",
          "description": "Regex pattern for deriving component names from root paths. First capture group becomes the name."
        },
        "extensions": {
          "type": "array",
          "items": { "type": "string" },
          "description": "File extensions owned by this kind."
        },
        "builders": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Build tool bindings."
        },
        "testers": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Test tool bindings."
        },
        "linters": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Lint tool bindings."
        },
        "scanners": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Scan tool bindings."
        },
        "bdd_runner": {
          "type": "string",
          "description": "Component kind to auto-create when this component declares a specs: facet. For example, go kind has bdd_runner 'godog'."
        },
        "pool": {
          "type": "string",
          "description": "Execution pool (host or docker)."
        },
        "build_after": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Intra-module build ordering."
        },
        "depends_on": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Component group dependencies."
        },
        "component_group": {
          "type": "string",
          "description": "Group name for dependency resolution."
        },
        "default_root": {
          "type": "string",
          "description": "Default root path pattern with {placeholder} support."
        },
        "requirements": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Runtime requirements (e.g., docker)."
        },
        "resources": {
          "type": "object",
          "description": "CPU/memory resource hints.",
          "properties": {
            "cpus": { "type": "integer" },
            "memory": { "type": "string" }
          }
        },
        "defaults": {
          "type": "object",
          "description": "Default configuration values.",
          "additionalProperties": true
        },
        "cache": {
          "type": "object",
          "description": "Cache configuration.",
          "additionalProperties": true
        },
        "files": {
          "$ref": "#/$defs/component_patterns",
          "description": "Default file patterns for source, tests, and config."
        }
      }
    },
    "component_patterns": {
      "type": "object",
      "description": "File patterns for source, test, and config files.",
      "properties": {
        "source": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Source file patterns."
        },
        "tests": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Test file patterns."
        },
        "config": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Configuration file patterns."
        },
        "data": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Data file patterns (owned but not processed by tools)."
        }
      }
    },
    "versioning_config": {
      "type": "object",
      "description": "Module versioning configuration.",
      "properties": {
        "scheme": {
          "type": "string",
          "description": "Versioning scheme (e.g., SemVer, CalVer, Implicit)."
        },
        "changelog": {
          "type": "string",
          "description": "Path to changelog file with {placeholder} support."
        },
        "release_type": {
          "type": "string",
          "description": "Release type (e.g., published, internal, none)."
        }
      }
    },
    "artifact_matrix": {
      "description": "Artifact matrix definition. Can be a simple array of entries or an object with extends/additional.",
      "oneOf": [
        {
          "type": "array",
          "items": { "$ref": "#/$defs/artifact_entry" },
          "description": "Simple matrix: array of artifact entries."
        },
        {
          "type": "object",
          "description": "Extended matrix: inherits from another matrix and adds entries.",
          "properties": {
            "extends": {
              "type": "string",
              "description": "Name of parent matrix to inherit entries from."
            },
            "additional": {
              "type": "array",
              "items": { "$ref": "#/$defs/artifact_entry" },
              "description": "Additional entries to add on top of parent."
            }
          }
        }
      ]
    },
    "artifact_entry": {
      "type": "object",
      "description": "A single artifact entry in a matrix.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Artifact identifier. Supports {placeholder} substitution."
        },
        "type": {
          "type": "string",
          "description": "Artifact type (e.g., executable, file, directory)."
        },
        "pattern": {
          "type": "string",
          "description": "Output file pattern. Supports {placeholder} substitution."
        },
        "compression": {
          "type": "string",
          "description": "Compression method (e.g., upx)."
        },
        "derive_from": {
          "type": "string",
          "description": "Source artifact to derive from. Supports {placeholder} substitution."
        }
      }
    }
  }
}
