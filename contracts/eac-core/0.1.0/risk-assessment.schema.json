{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "risk-assessment.schema.json",
  "title": "AI Risk Assessment Output",
  "description": "Complete risk assessment with executive summary and per-module analysis",
  "type": "object",
  "required": ["executive_summary", "module_analyses", "confidence"],
  "properties": {
    "executive_summary": {
      "type": "object",
      "required": ["overall_risk_posture", "summary_narrative", "key_findings", "strategic_recommendations"],
      "properties": {
        "overall_risk_posture": {
          "type": "string",
          "enum": ["critical", "high", "moderate", "low"],
          "description": "Overall risk level across all assessed modules"
        },
        "summary_narrative": {
          "type": "string",
          "minLength": 100,
          "maxLength": 1000,
          "description": "2-3 paragraph executive summary of overall risk posture"
        },
        "key_findings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 20
          },
          "minItems": 3,
          "maxItems": 7,
          "description": "Most important findings across all modules"
        },
        "critical_modules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["module", "reason"],
            "properties": {
              "module": {
                "type": "string",
                "description": "Module name"
              },
              "reason": {
                "type": "string",
                "minLength": 20,
                "description": "Why this module requires immediate attention"
              }
            }
          },
          "description": "Modules requiring immediate attention"
        },
        "trends": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 20
          },
          "description": "Patterns and trends observed across modules"
        },
        "strategic_recommendations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 30
          },
          "minItems": 2,
          "maxItems": 5,
          "description": "High-level strategic recommendations for risk mitigation"
        }
      }
    },
    "module_analyses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["module", "computed_likelihood", "reasoning", "risk_summary"],
        "properties": {
          "module": {
            "type": "string",
            "description": "Module name"
          },
          "computed_likelihood": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "description": "Likelihood score (1=Rare, 2=Unlikely, 3=Possible, 4=Likely, 5=Almost Certain)"
          },
          "reasoning": {
            "type": "string",
            "minLength": 30,
            "description": "Explanation of how likelihood was computed for this module"
          },
          "risk_summary": {
            "type": "string",
            "minLength": 20,
            "maxLength": 200,
            "description": "One sentence summary of this module's risk posture"
          },
          "recommended_controls": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z]{2}-[0-9]+$"
            },
            "description": "NIST 800-53 control IDs to reduce likelihood for this module"
          }
        }
      },
      "minItems": 1,
      "description": "Per-module risk analysis results"
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Overall confidence in the assessment"
    }
  }
}
