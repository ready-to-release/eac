{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ai-config.schema.json",
  "title": "AI Configuration",
  "description": "Configuration for AI-assisted generation including validation rules and anti-corruption filters",
  "type": "object",
  "required": ["version", "name", "types"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version of the configuration"
    },
    "name": {
      "type": "string",
      "description": "Name of this configuration"
    },
    "description": {
      "type": "string",
      "description": "Description of this configuration"
    },
    "defaults": {
      "$ref": "#/$defs/defaults",
      "description": "Default settings inherited by all types"
    },
    "types": {
      "type": "object",
      "description": "Type-specific configurations keyed by type name",
      "additionalProperties": {
        "$ref": "#/$defs/typeConfig"
      }
    }
  },
  "$defs": {
    "antiCorruptionRules": {
      "type": "object",
      "description": "Rules for filtering AI output noise",
      "properties": {
        "forbidden_prefixes": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Prefixes to strip from output start"
        },
        "forbidden_contains": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Substrings indicating noise to filter"
        },
        "forbidden_emojis": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Emojis to remove from output"
        },
        "agent_signatures": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Agent signature patterns to strip"
        }
      },
      "additionalProperties": false
    },
    "defaults": {
      "type": "object",
      "description": "Default settings inherited by all types",
      "properties": {
        "anti_corruption": {
          "$ref": "#/$defs/antiCorruptionRules"
        }
      },
      "additionalProperties": false
    },
    "outputConfig": {
      "type": "object",
      "description": "Output parsing configuration",
      "properties": {
        "start_marker": {
          "type": ["string", "null"],
          "description": "Marker indicating start of valid content (null = immediate start)"
        },
        "format": {
          "type": "string",
          "enum": ["text", "dsl", "gherkin", "yaml", "json", "markdown"],
          "description": "Expected output format"
        }
      },
      "additionalProperties": false
    },
    "typeConfig": {
      "type": "object",
      "description": "Configuration for a specific AI generation type",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Display name for this type"
        },
        "description": {
          "type": "string",
          "description": "Description of what this type generates"
        },
        "output": {
          "$ref": "#/$defs/outputConfig",
          "description": "Output parsing configuration"
        },
        "validation": {
          "type": "object",
          "description": "Type-specific validation rules",
          "additionalProperties": true
        },
        "data": {
          "type": "object",
          "description": "Reference data files to inject (key: path)",
          "additionalProperties": {
            "type": "string"
          }
        },
        "anti_corruption": {
          "$ref": "#/$defs/antiCorruptionRules",
          "description": "Type-specific anti-corruption additions/overrides"
        }
      },
      "additionalProperties": false
    }
  }
}
