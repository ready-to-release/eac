{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ready-to-release.org/schemas/eac-core/agent-config/0.1.0",
  "title": "Agent Configuration Schema",
  "description": "Schema for AI provider configuration used by commit message generation and other AI features",
  "type": "object",
  "properties": {
    "provider": {
      "$ref": "#/definitions/provider_config",
      "description": "AI provider configuration"
    }
  },
  "required": ["provider"],
  "definitions": {
    "provider_config": {
      "type": "object",
      "description": "AI provider settings",
      "properties": {
        "name": {
          "type": "string",
          "description": "Provider identifier",
          "enum": ["claude-cli", "claude-api", "openai", "gemini"]
        },
        "model": {
          "type": "string",
          "description": "AI model to use (e.g., claude-3-haiku-20240307, gpt-4-turbo)"
        },
        "endpoint": {
          "type": "string",
          "description": "API endpoint URL (not needed for claude-cli)",
          "format": "uri"
        },
        "api_key": {
          "type": "string",
          "description": "API key - can use ${ENV_VAR} syntax for environment variable substitution"
        }
      },
      "required": ["name"]
    }
  }
}
