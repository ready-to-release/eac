{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ready-to-release.org/schemas/eac-core/test-manifest/0.1.0",
  "title": "Test Manifest Schema",
  "description": "Schema for per-module test manifests stored at out/test/<module>/test.manifest.json. Each manifest aggregates test results across all suite runs and tracks incremental test state.",
  "type": "object",
  "properties": {
    "test_id": {
      "type": "string",
      "description": "Unique identifier for this test run (UUID locally, GitHub run ID in CI)"
    },
    "test_agent": {
      "type": "string",
      "enum": ["ci", "devbox"],
      "description": "Test agent type: 'ci' for GitHub Actions runs, 'devbox' for local developer runs"
    },
    "moniker": {
      "type": "string",
      "minLength": 1,
      "description": "Module identifier (moniker) that was tested"
    },
    "type": {
      "type": "string",
      "minLength": 1,
      "description": "Module type (e.g., go, container, typescript, static)"
    },
    "test_time": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of when the test manifest was last updated"
    },
    "duration_seconds": {
      "type": "number",
      "minimum": 0,
      "description": "Total test duration in seconds (most recent run)"
    },
    "git_commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$",
      "description": "Git commit SHA (40 hex characters) at test time"
    },
    "input_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA-256 hash of source and test files for incremental test detection"
    },
    "summary": {
      "$ref": "#/definitions/test_summary",
      "description": "Aggregated test counts across all suites"
    },
    "suites": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/suite_result"
      },
      "description": "Per-suite test results, keyed by suite moniker (component, integration, acceptance, etc.)"
    },
    "tests": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/test_entry"
      },
      "description": "Individual test results from all suite runs"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/artifact_info"
      },
      "description": "Test artifacts produced (logs, reports, coverage files)"
    },
    "verified_unchanged_at": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$",
      "description": "Git SHA when tests were last verified unchanged and skipped. Can be updated after initial creation."
    },
    "version": {
      "type": "string",
      "const": "1.0",
      "description": "Manifest format version"
    }
  },
  "required": ["test_id", "test_agent", "moniker", "type", "test_time", "summary", "tests", "artifacts", "version"],
  "definitions": {
    "test_summary": {
      "type": "object",
      "description": "Aggregated test counts",
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0,
          "description": "Total number of tests"
        },
        "passed": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of tests that passed"
        },
        "failed": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of tests that failed"
        },
        "skipped": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of tests that were skipped"
        },
        "pending": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of tests marked as pending implementation"
        },
        "undefined": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of tests with undefined step definitions (godog/cucumber)"
        }
      },
      "required": ["total", "passed", "failed", "skipped"]
    },
    "suite_result": {
      "type": "object",
      "description": "Results for a specific test suite run",
      "properties": {
        "run_time": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp when this suite was last run"
        },
        "duration_seconds": {
          "type": "number",
          "minimum": 0,
          "description": "Suite execution duration in seconds"
        },
        "tests": {
          "$ref": "#/definitions/test_summary",
          "description": "Test counts for this suite"
        }
      },
      "required": ["run_time", "duration_seconds", "tests"]
    },
    "test_entry": {
      "type": "object",
      "description": "Individual test result",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Test name or scenario name"
        },
        "package": {
          "type": "string",
          "description": "Package path containing the test"
        },
        "type": {
          "type": "string",
          "enum": ["gotest", "godog", "mocha", "tscucumber"],
          "description": "Test type/runner"
        },
        "suite": {
          "type": "string",
          "description": "Suite this test belongs to (component, integration, acceptance, etc.)"
        },
        "status": {
          "type": "string",
          "enum": ["passed", "failed", "skipped", "undefined", "pending"],
          "description": "Test execution status"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "Test execution duration in milliseconds"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Tags applied to this test"
        },
        "error": {
          "type": "string",
          "description": "Error message if test failed"
        },
        "file_path": {
          "type": "string",
          "description": "Source file path containing the test"
        }
      },
      "required": ["name", "package", "type", "suite", "status"]
    },
    "artifact_info": {
      "type": "object",
      "description": "Information about a test artifact",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["log", "report", "coverage", "file"],
          "description": "Artifact type"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Artifact identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Artifact filename"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Relative path from module test output directory"
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "description": "File size in bytes"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "SHA-256 hash of artifact content"
        }
      },
      "required": ["type", "id", "name", "path"]
    }
  }
}
