{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ready-to-release.org/schemas/eac-core/module-types/0.1.0",
  "title": "Module Type Registry Schema",
  "description": "Schema for module type definitions mapping types to build systems, capabilities, and default values",
  "type": "object",
  "properties": {
    "types": {
      "type": "array",
      "description": "Module type definitions",
      "items": {
        "$ref": "#/definitions/module_type"
      }
    }
  },
  "required": ["types"],
  "definitions": {
    "module_type": {
      "type": "object",
      "description": "A module type definition",
      "properties": {
        "name": {
          "type": "string",
          "description": "Module type name (e.g., go-cli, mkdocs-site)",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "description": {
          "type": "string",
          "description": "Human-readable description of this type"
        },
        "build_deps": {
          "type": "array",
          "description": "System dependencies required for building this module type. References monikers from system-dependencies.yml",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "default": []
        },
        "capabilities": {
          "type": "array",
          "description": "List of capabilities this type has",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "default": []
        },
        "test_framework": {
          "type": "string",
          "description": "Unit test framework for this module type (e.g., mocha, jest, pytest, go)",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "bdd_framework": {
          "type": "string",
          "description": "BDD test framework for Gherkin specs (e.g., godog, tscucumber). If not specified, inferred from build_deps.",
          "enum": ["godog", "tscucumber"]
        },
        "build": {
          "$ref": "#/definitions/build_config",
          "description": "Build output configuration for this module type"
        },
        "defaults": {
          "$ref": "#/definitions/type_defaults",
          "description": "Default values applied to modules of this type"
        }
      },
      "required": ["name", "build_deps"]
    },
    "type_defaults": {
      "type": "object",
      "description": "Default values for modules of this type. Supports variable substitution: {moniker}, {root}, {type}",
      "properties": {
        "files": {
          "$ref": "#/definitions/files_defaults"
        },
        "repo": {
          "$ref": "#/definitions/repo_defaults"
        },
        "flags": {
          "$ref": "#/definitions/flags_defaults"
        }
      }
    },
    "files_defaults": {
      "type": "object",
      "description": "Default file pattern configurations",
      "properties": {
        "source": {
          "type": "array",
          "description": "Default source file patterns (glob)",
          "items": {
            "type": "string"
          }
        },
        "config": {
          "type": "array",
          "description": "Default configuration file patterns (glob)",
          "items": {
            "type": "string"
          }
        },
        "assets": {
          "type": "array",
          "description": "Default asset file patterns (glob)",
          "items": {
            "type": "string"
          }
        },
        "tests": {
          "type": "array",
          "description": "Default test file patterns (glob)",
          "items": {
            "type": "string"
          }
        },
        "changelog": {
          "type": "string",
          "description": "Default changelog filename"
        },
        "workflows": {
          "$ref": "#/definitions/workflows_defaults"
        }
      }
    },
    "workflows_defaults": {
      "type": "object",
      "description": "Default workflow file paths",
      "properties": {
        "ci": {
          "type": "string",
          "description": "CI workflow file path"
        },
        "release": {
          "type": "string",
          "description": "Release workflow file path"
        }
      }
    },
    "repo_defaults": {
      "type": "object",
      "description": "Default repository-level file configurations",
      "properties": {
        "specs": {
          "type": "array",
          "description": "Default spec file patterns. Use {moniker} for module name substitution.",
          "items": {
            "type": "string"
          }
        },
        "test_impl": {
          "type": "string",
          "description": "Default test implementation path. Use {root} or {moniker} for substitution."
        },
        "design": {
          "type": "string",
          "description": "Default design workspace path. Use {moniker} for substitution."
        }
      }
    },
    "flags_defaults": {
      "type": "object",
      "description": "Default flag values (reserved for future use)",
      "properties": {}
    },
    "build_config": {
      "type": "object",
      "description": "Build output configuration",
      "properties": {
        "artifacts": {
          "type": "array",
          "description": "Expected build artifacts for this module type",
          "items": {
            "$ref": "#/definitions/artifact"
          },
          "default": []
        },
        "post_build": {
          "type": "array",
          "description": "Post-build steps to execute after successful build",
          "items": {
            "$ref": "#/definitions/post_build_step"
          },
          "default": []
        }
      }
    },
    "post_build_step": {
      "type": "object",
      "description": "A post-build step definition",
      "required": ["action"],
      "properties": {
        "action": {
          "type": "string",
          "description": "Type of post-build action",
          "enum": ["copy", "script"]
        },
        "target": {
          "type": "string",
          "description": "Target path relative to repo root (for copy action). Variables: {moniker}, {root}"
        },
        "include": {
          "type": "array",
          "description": "Glob patterns to include from build output (for copy action)",
          "items": {
            "type": "string"
          }
        },
        "exclude": {
          "type": "array",
          "description": "Glob patterns to exclude (for copy action)",
          "items": {
            "type": "string"
          }
        },
        "script": {
          "type": "string",
          "description": "Script command to run (for script action). Variables: {moniker}, {root}, {output_dir}"
        }
      }
    },
    "artifact": {
      "type": "object",
      "description": "A build artifact definition",
      "required": ["type", "pattern"],
      "properties": {
        "type": {
          "type": "string",
          "description": "Artifact type",
          "enum": ["executable", "file", "directory", "marker", "image", "glob"]
        },
        "pattern": {
          "type": "string",
          "description": "Path pattern relative to build output. Variables: {moniker}, {os}, {arch}, {ext}"
        },
        "id": {
          "type": "string",
          "description": "Optional explicit ID for metadata override key (e.g., 'output', 'book'). If not specified, variant is derived from pattern variables.",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "platforms": {
          "type": "array",
          "description": "Platforms this artifact is built for (for executables)",
          "items": {
            "type": "string",
            "enum": ["linux", "windows", "darwin"]
          }
        },
        "verify": {
          "type": "string",
          "description": "Verification mode: current_platform (default), all, any",
          "enum": ["current_platform", "all", "any"],
          "default": "current_platform"
        }
      }
    }
  }
}
