{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ready-to-release.org/schemas/eac-core/repository/0.1.0",
  "title": "Repository Configuration Schema",
  "description": "Schema for repository-level configuration including type, versioning schemes, and workflow policies",
  "type": "object",
  "properties": {
    "repository": {
      "$ref": "#/definitions/repository_config",
      "description": "Repository-level configuration and metadata"
    },
    "paths": {
      "$ref": "#/definitions/paths_config",
      "description": "Repository path configuration (optional, has sensible defaults)"
    },
    "conventions": {
      "$ref": "#/definitions/conventions_config",
      "description": "Filename conventions (optional, has sensible defaults)"
    }
  },
  "required": ["repository"],
  "definitions": {
    "repository_config": {
      "type": "object",
      "description": "Repository-level configuration",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["mono", "poly", "adjunct"],
          "description": "Repository type: mono (monorepo), poly (polyrepo), adjunct (supporting repo)"
        },
        "schemes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["SemVer", "CalVer"]
          },
          "description": "Valid versioning schemes that modules can declare",
          "default": ["SemVer", "CalVer"],
          "minItems": 1
        },
        "trunk_branch": {
          "type": "string",
          "description": "Main branch name for trunk-based development",
          "default": "main",
          "minLength": 1
        },
        "max_branch_age_days": {
          "type": "integer",
          "description": "Maximum age in days for feature branches",
          "minimum": 1,
          "default": 2
        },
        "pr": {
          "$ref": "#/definitions/pr_config",
          "description": "Pull request configuration"
        },
        "versioning": {
          "$ref": "#/definitions/versioning_config",
          "description": "Repository-wide versioning constraints and behavior"
        }
      },
      "additionalProperties": false
    },
    "pr_config": {
      "type": "object",
      "description": "Pull request workflow configuration",
      "properties": {
        "delete_branch_on_merge": {
          "type": "boolean",
          "description": "Automatically delete branch after PR merge",
          "default": true
        },
        "merge_strategy": {
          "type": "string",
          "enum": ["squash", "merge", "rebase"],
          "description": "Default merge strategy for pull requests",
          "default": "squash"
        }
      },
      "default": {
        "delete_branch_on_merge": true,
        "merge_strategy": "squash"
      }
    },
    "versioning_config": {
      "type": "object",
      "description": "Repository-wide versioning constraints and behavior control",
      "properties": {
        "constraint": {
          "type": "string",
          "enum": ["unrestricted", "patch-only", "calver-only"],
          "description": "Global constraint on version bumping. unrestricted: Allow major, minor, and patch bumps based on conventional commits. patch-only: For semver modules, only allow patch bumps (0.0.x → 0.0.x+1) - stops major/minor bumps during early development. calver-only: Force all modules to use calendar versioning.",
          "default": "unrestricted"
        }
      },
      "default": {
        "constraint": "unrestricted"
      }
    },
    "paths_config": {
      "type": "object",
      "description": "Repository path configuration for specs, tests, and output directories",
      "properties": {
        "specs_root": {
          "type": "string",
          "description": "Root directory for feature specifications",
          "default": "specs"
        },
        "test_impl_root": {
          "type": "string",
          "description": "Root directory for test implementations (godog steps, etc.)",
          "default": "tests"
        },
        "templates": {
          "type": "string",
          "description": "Templates directory",
          "default": "templates"
        },
        "out": {
          "$ref": "#/definitions/out_paths",
          "description": "Output directory structure"
        }
      }
    },
    "out_paths": {
      "type": "object",
      "description": "Output directory structure for build artifacts, test results, and logs",
      "properties": {
        "root": {
          "type": "string",
          "description": "Root output directory",
          "default": "out"
        },
        "build": {
          "type": "string",
          "description": "Build output directory",
          "default": "out/build"
        },
        "test": {
          "type": "string",
          "description": "Test output directory",
          "default": "out/test"
        },
        "logs": {
          "type": "string",
          "description": "Logs output directory",
          "default": "out/logs"
        },
        "security": {
          "type": "string",
          "description": "Security scan output directory",
          "default": "out/security"
        },
        "tools": {
          "type": "string",
          "description": "Tools output directory (CI tools like commands binary)",
          "default": "out/tools"
        }
      }
    },
    "conventions_config": {
      "type": "object",
      "description": "Filename conventions used across the repository",
      "properties": {
        "godog_test": {
          "type": "string",
          "description": "Godog test file name",
          "default": "godog_test.go"
        },
        "package_json": {
          "type": "string",
          "description": "Node.js package file name",
          "default": "package.json"
        },
        "changelog": {
          "type": "string",
          "description": "Changelog file name",
          "default": "CHANGELOG.md"
        }
      }
    }
  }
}
