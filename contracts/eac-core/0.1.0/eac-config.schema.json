{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ready-to-release.org/schemas/eac-core/eac-config/0.1.0",
  "title": "EAC Configuration Schema",
  "description": "Schema for EAC configuration including AI provider and Git settings",
  "type": "object",
  "properties": {
    "ai": {
      "$ref": "#/definitions/ai_config",
      "description": "AI provider configuration"
    },
    "git": {
      "$ref": "#/definitions/git_config",
      "description": "Git provider configuration"
    }
  },
  "required": ["ai"],
  "definitions": {
    "ai_config": {
      "type": "object",
      "description": "AI provider settings",
      "properties": {
        "provider": {
          "type": "string",
          "description": "Provider identifier",
          "enum": ["claude-cli", "claude-api", "openai", "gemini", "test"]
        },
        "model": {
          "type": "string",
          "description": "AI model to use (e.g., claude-3-haiku-20240307, gpt-4-turbo)"
        },
        "endpoint": {
          "type": "string",
          "description": "API endpoint URL (not needed for claude-cli)",
          "format": "uri"
        },
        "api_key": {
          "type": "string",
          "description": "API key - can use ${ENV_VAR} syntax for environment variable substitution"
        }
      },
      "required": ["provider"]
    },
    "git_config": {
      "type": "object",
      "description": "Git provider settings",
      "properties": {
        "token": {
          "type": "string",
          "description": "Git provider API token (GitHub, GitLab, etc.) - can use ${ENV_VAR} syntax for environment variable substitution"
        }
      }
    }
  }
}
