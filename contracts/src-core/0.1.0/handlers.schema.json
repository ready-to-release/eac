{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ready-to-release.org/schemas/src-core/handlers/0.1.0",
  "title": "Handler Configuration Schema",
  "description": "Schema for build and test handler definitions",
  "type": "object",
  "properties": {
    "handlers": {
      "type": "array",
      "description": "Handler definitions",
      "items": {
        "$ref": "#/definitions/handler"
      }
    },
    "dispatch": {
      "$ref": "#/definitions/dispatch_rules",
      "description": "Rules for selecting handlers based on module properties"
    }
  },
  "required": ["handlers"],
  "definitions": {
    "handler": {
      "type": "object",
      "description": "A handler definition for a build dependency",
      "properties": {
        "name": {
          "type": "string",
          "description": "Handler name (matches build_dep from module-types.yml or custom name)",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "description": {
          "type": "string",
          "description": "Human-readable description"
        },
        "type": {
          "type": "string",
          "description": "Handler type",
          "enum": ["builtin", "command", "script", "docker"]
        },
        "build": {
          "$ref": "#/definitions/handler_spec",
          "description": "Build handler specification"
        },
        "test": {
          "$ref": "#/definitions/handler_spec",
          "description": "Test handler specification"
        }
      },
      "required": ["name", "type"]
    },
    "handler_spec": {
      "oneOf": [
        { "$ref": "#/definitions/builtin_handler" },
        { "$ref": "#/definitions/command_handler" },
        { "$ref": "#/definitions/script_handler" },
        { "$ref": "#/definitions/docker_handler" }
      ]
    },
    "builtin_handler": {
      "type": "object",
      "description": "Reference to a compiled Go handler",
      "properties": {
        "handler": {
          "type": "string",
          "description": "Name of the builtin handler (go, docker, static, none)"
        },
        "config": {
          "type": "object",
          "description": "Handler-specific configuration",
          "additionalProperties": true
        },
        "flags": {
          "type": "array",
          "description": "Handler-specific CLI flags",
          "items": {
            "$ref": "#/definitions/handler_flag"
          }
        }
      },
      "required": ["handler"]
    },
    "handler_flag": {
      "type": "object",
      "description": "A CLI flag definition for a handler",
      "properties": {
        "name": {
          "type": "string",
          "description": "Internal flag name (used in code)",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "type": {
          "type": "string",
          "description": "Flag value type",
          "enum": ["bool", "string", "int"]
        },
        "cli_positive": {
          "type": "string",
          "description": "Positive CLI flag (e.g., '--tidy-first')",
          "pattern": "^--[a-z][a-z0-9-]*$"
        },
        "cli_negative": {
          "type": "string",
          "description": "Negative CLI flag for bool types (e.g., '--no-tidy')",
          "pattern": "^--[a-z][a-z0-9-]*$"
        },
        "value_flag": {
          "type": "string",
          "description": "CLI flag that takes a value (e.g., '--version')",
          "pattern": "^--[a-z][a-z0-9-]*$"
        },
        "default": {
          "description": "Default value when flag is not specified"
        },
        "default_env": {
          "type": "object",
          "description": "Environment-specific defaults (CI, local)",
          "properties": {
            "CI": {
              "description": "Default value in CI environment"
            },
            "local": {
              "description": "Default value in local environment"
            }
          },
          "additionalProperties": false
        },
        "description": {
          "type": "string",
          "description": "Help text for the flag"
        }
      },
      "required": ["name", "type"]
    },
    "command_handler": {
      "type": "object",
      "description": "Sequence of shell commands",
      "properties": {
        "steps": {
          "type": "array",
          "description": "Ordered list of command steps",
          "items": {
            "$ref": "#/definitions/command_step"
          }
        },
        "flags": {
          "type": "array",
          "description": "Handler-specific CLI flags",
          "items": {
            "$ref": "#/definitions/handler_flag"
          }
        }
      },
      "required": ["steps"]
    },
    "command_step": {
      "type": "object",
      "description": "A single command step",
      "properties": {
        "name": {
          "type": "string",
          "description": "Step name for logging"
        },
        "command": {
          "type": "string",
          "description": "Shell command to execute"
        },
        "workdir": {
          "type": "string",
          "description": "Working directory (supports {root}, {workspace} substitution)"
        },
        "env": {
          "type": "object",
          "description": "Environment variables to set",
          "additionalProperties": {
            "type": "string"
          }
        },
        "when": {
          "type": "string",
          "description": "Conditional execution (capability:name, file_exists:path)"
        },
        "continue_on_error": {
          "type": "boolean",
          "description": "Continue execution if this step fails",
          "default": false
        }
      },
      "required": ["name", "command"]
    },
    "script_handler": {
      "type": "object",
      "description": "External script execution",
      "properties": {
        "script": {
          "type": "string",
          "description": "Path to script file (relative to workspace root)"
        },
        "interpreter": {
          "type": "string",
          "description": "Script interpreter (sh, bash, pwsh)"
        },
        "args": {
          "type": "array",
          "description": "Arguments to pass to script",
          "items": {
            "type": "string"
          }
        },
        "env": {
          "type": "object",
          "description": "Environment variables to set",
          "additionalProperties": {
            "type": "string"
          }
        },
        "flags": {
          "type": "array",
          "description": "Handler-specific CLI flags",
          "items": {
            "$ref": "#/definitions/handler_flag"
          }
        }
      },
      "required": ["script"]
    },
    "docker_handler": {
      "type": "object",
      "description": "Docker container-based handler",
      "properties": {
        "image": {
          "type": "string",
          "description": "Docker image name:tag"
        },
        "dockerfile": {
          "type": "string",
          "description": "Path to Dockerfile for building image if not exists"
        },
        "context": {
          "type": "string",
          "description": "Docker build context path"
        },
        "command": {
          "type": "array",
          "description": "Command to run in container",
          "items": {
            "type": "string"
          }
        },
        "workdir": {
          "type": "string",
          "description": "Working directory inside container"
        },
        "volumes": {
          "type": "array",
          "description": "Volume mounts (host:container format with {workspace} substitution)",
          "items": {
            "type": "string"
          }
        },
        "env": {
          "type": "object",
          "description": "Environment variables to set",
          "additionalProperties": {
            "type": "string"
          }
        },
        "config": {
          "type": "object",
          "description": "Additional configuration",
          "additionalProperties": true
        },
        "flags": {
          "type": "array",
          "description": "Handler-specific CLI flags",
          "items": {
            "$ref": "#/definitions/handler_flag"
          }
        }
      },
      "required": ["image"]
    },
    "dispatch_rules": {
      "type": "object",
      "description": "Rules for dispatching to handlers",
      "properties": {
        "build": {
          "type": "array",
          "description": "Build handler dispatch rules (evaluated in order)",
          "items": {
            "$ref": "#/definitions/dispatch_rule"
          }
        },
        "test": {
          "type": "array",
          "description": "Test handler dispatch rules (evaluated in order)",
          "items": {
            "$ref": "#/definitions/dispatch_rule"
          }
        }
      }
    },
    "dispatch_rule": {
      "type": "object",
      "description": "A single dispatch rule",
      "properties": {
        "match": {
          "$ref": "#/definitions/match_condition",
          "description": "Conditions to match"
        },
        "handler": {
          "type": "string",
          "description": "Handler name to use (supports {primary_build_dep} substitution)"
        }
      },
      "required": ["match", "handler"]
    },
    "match_condition": {
      "type": "object",
      "description": "Conditions for matching a module",
      "properties": {
        "type": {
          "type": "string",
          "description": "Exact module type to match"
        },
        "capabilities": {
          "type": "array",
          "description": "Required capabilities (all must be present)",
          "items": {
            "type": "string"
          }
        },
        "build_dep": {
          "type": "string",
          "description": "Primary build dependency to match"
        },
        "default": {
          "type": "boolean",
          "description": "Default rule (matches if no other rules match)"
        }
      }
    },
    "cross_compile_target": {
      "type": "object",
      "description": "Cross-compilation target platform",
      "properties": {
        "os": {
          "type": "string",
          "description": "Target operating system (GOOS)"
        },
        "arch": {
          "type": "string",
          "description": "Target architecture (GOARCH)"
        },
        "suffix": {
          "type": "string",
          "description": "Binary file suffix (e.g., .exe for Windows)"
        }
      },
      "required": ["os", "arch"]
    }
  }
}
