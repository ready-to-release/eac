{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ready-to-release.org/schemas/src-core/environments/0.1.0",
  "title": "Environments Contract Schema",
  "description": "Schema for the environment contract defining test execution contexts",
  "type": "object",
  "properties": {
    "environments": {
      "type": "array",
      "description": "List of test execution environments",
      "items": {
        "$ref": "#/definitions/environment"
      },
      "minItems": 1
    }
  },
  "required": ["environments"],
  "definitions": {
    "environment": {
      "type": "object",
      "description": "A test execution environment definition",
      "properties": {
        "moniker": {
          "type": "string",
          "description": "Unique environment identifier",
          "pattern": "^[a-z][a-z0-9-]*$",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "description": "Human-readable environment name",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "description": "Description of the environment"
        },
        "level": {
          "type": "string",
          "description": "Test level classification",
          "enum": ["L0", "L1", "L2", "L3", "L4"]
        },
        "type": {
          "type": "string",
          "description": "Environment type",
          "enum": ["unit", "docker", "docker-compose", "plte", "production"]
        },
        "system_deps": {
          "type": "array",
          "description": "Required system dependencies (e.g., docker, go, helm)",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        }
      },
      "required": ["moniker", "name", "level", "type"]
    }
  },
  "examples": [
    {
      "environments": [
        {
          "moniker": "l00-01",
          "name": "L0 Environment 01 - In-process Unit Tests",
          "description": "Very fast unit tests running in-process with direct access to source",
          "level": "L0",
          "type": "unit",
          "system_deps": []
        },
        {
          "moniker": "local01",
          "name": "Local Environment 01 - Docker Container",
          "description": "Single Docker container execution environment",
          "level": "L2",
          "type": "docker",
          "system_deps": ["docker"]
        }
      ]
    }
  ]
}
