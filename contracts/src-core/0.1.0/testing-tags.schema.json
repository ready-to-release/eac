{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ready-to-release.org/schemas/src-core/testing-tags/0.1.0",
  "title": "Testing Tags Contract Schema",
  "description": "Schema for the test tagging system specification defining test classification and dependency management",
  "type": "object",
  "properties": {
    "tags": {
      "type": "array",
      "description": "Tag definitions for test classification",
      "items": {
        "$ref": "#/definitions/tag_definition"
      }
    },
    "types": {
      "type": "array",
      "description": "Tag type definitions",
      "items": {
        "$ref": "#/definitions/tag_type"
      }
    },
    "skip_reasons": {
      "type": "array",
      "description": "Valid skip reason codes",
      "items": {
        "$ref": "#/definitions/skip_reason"
      }
    }
  },
  "required": ["tags", "types", "skip_reasons"],
  "definitions": {
    "tag_definition": {
      "type": "object",
      "description": "A single tag definition",
      "properties": {
        "tag": {
          "type": "string",
          "description": "The tag string (may include placeholders like <reason>)",
          "pattern": "^@[a-zA-Z][a-zA-Z0-9-]*(:.*)?$"
        },
        "name": {
          "type": "string",
          "description": "Human-readable name for the tag"
        },
        "description": {
          "type": "string",
          "description": "Description of what the tag means"
        },
        "type": {
          "type": "string",
          "description": "Tag type category",
          "enum": [
            "system_dependency",
            "module_dependency",
            "environment",
            "taxonomy-level",
            "verification",
            "safety",
            "execution_control",
            "test_behavior",
            "risk_control",
            "risk_control_gxp",
            "gxp_regulatory"
          ]
        },
        "level": {
          "type": "string",
          "description": "Where the tag can be applied",
          "enum": ["feature-or-scenario", "scenario", "feature"]
        },
        "pattern": {
          "type": "string",
          "description": "Regex pattern for parameterized tags"
        },
        "example": {
          "type": "string",
          "description": "Example usage of the tag"
        },
        "note": {
          "type": "string",
          "description": "Additional notes about the tag"
        },
        "constraint": {
          "type": "string",
          "description": "Constraint rules for the tag",
          "enum": ["mutually_exclusive_with_taxonomy_levels"]
        }
      },
      "required": ["tag", "type"]
    },
    "tag_type": {
      "type": "object",
      "description": "Tag type category definition",
      "properties": {
        "type": {
          "type": "string",
          "description": "Type identifier"
        },
        "description": {
          "type": "string",
          "description": "Description of this tag type"
        }
      },
      "required": ["type", "description"]
    },
    "skip_reason": {
      "type": "object",
      "description": "Valid skip reason code",
      "properties": {
        "code": {
          "type": "string",
          "description": "Skip reason code",
          "pattern": "^[a-z]+$"
        },
        "name": {
          "type": "string",
          "description": "Human-readable name"
        },
        "description": {
          "type": "string",
          "description": "Description of when to use this skip reason"
        }
      },
      "required": ["code", "name", "description"]
    }
  },
  "examples": [
    {
      "tags": [
        {
          "tag": "@L0",
          "name": "Very Fast Unit Tests",
          "type": "taxonomy-level"
        },
        {
          "tag": "@skip:<reason>",
          "description": "Exclude from test runs",
          "type": "execution_control",
          "pattern": "^@skip:(?P<reason>[a-z]+)$",
          "example": "@skip:wip"
        }
      ],
      "types": [
        {
          "type": "taxonomy-level",
          "description": "Test environment complexity level"
        }
      ],
      "skip_reasons": [
        {
          "code": "wip",
          "name": "Work In Progress",
          "description": "Test implementation not yet complete"
        }
      ]
    }
  ]
}
