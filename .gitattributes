# Linguist Section
## Detect Markdown as code
## See: https://github.com/github-linguist/linguist/issues/5951
*.md linguist-vendored=false
*.md linguist-generated=false
*.md linguist-documentation=false
*.md linguist-detectable=true
# Export-Ignore Section for GitHub Release Archives
# This controls what gets included in the auto-generated source archives
## Exclude everything by default
/* export-ignore
## Then selectively include only source code and essential files
# Go source code
/go -export-ignore
/go/** -export-ignore
# Go module files
/go.mod -export-ignore
/go.sum -export-ignore
# GitHub workflows (for transparency/reproducibility)
/.github/workflows/*r2r-cli*.yml -export-ignore
# Docs
/documentation -export-ignore
# Keep the gitignore and gitattributes for proper repo setup
/.gitignore -export-ignore
/.gitattributes -export-ignore
automation/.external/** filter=lfs diff=lfs merge=lfs -text

# Line ending normalization for Go source files
*.go text eol=lf
*.mod text eol=lf
*.sum text eol=lf

# Markdown files must use LF line endings (for consistent mermaid diagram hashing)
*.md text eol=lf

# Shell scripts must use LF line endings
*.sh text eol=lf

# Structurizr DSL files must use LF (for consistent cache hashing across platforms)
*.dsl text eol=lf
