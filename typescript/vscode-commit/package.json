{
  "name": "vscode-commit",
  "displayName": "Commit Message AI",
  "description": "A VSCode extension that generates AI-powered semantic commit messages using the 7-lever commit system",
  "version": "0.1.0",
  "publisher": "ready-to-release",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "SCM Providers"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vscode-commit.generateCommitMessage",
        "title": "Generate Commit Message",
        "icon": "$(hubot)"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "vscode-commit.generateCommitMessage",
          "group": "navigation",
          "when": "scmProvider == git"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsc -p ./",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "test": "mocha",
    "test:cucumber": "cucumber-js"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^12.3.0",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.0",
    "@types/node": "^25.0.2",
    "@types/vscode": "^1.80.0",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "chai": "^6.2.2",
    "eslint": "^10.0.2",
    "mocha": "^11.7.5",
    "ts-node": "^10.9.0",
    "tsx": "^4.19.0",
    "typescript": "^5.0.0"
  }
}
