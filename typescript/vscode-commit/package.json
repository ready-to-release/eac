{
  "name": "vscode-commit",
  "displayName": "Commit Message AI",
  "description": "VSCode extension for AI-powered semantic commit message generation",
  "version": "0.1.0",
  "publisher": "local",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vscode-commit.callMCP",
        "title": "Generate Commit Message",
        "icon": "$(robot)"
      },
      {
        "command": "vscode-commit.noOp",
        "title": "No Staged Changes",
        "icon": "$(circle-slash)"
      },
      {
        "command": "vscode-commit.showOutput",
        "title": "Commit Message AI: Show Output",
        "icon": "$(output)"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "vscode-commit.noOp",
          "group": "navigation@1",
          "when": "scmProvider == git && !vscode-commit.isGenerating && !vscode-commit.hasStagedChanges",
          "icon": "$(circle-slash)"
        },
        {
          "command": "vscode-commit.callMCP",
          "group": "navigation@2",
          "when": "scmProvider == git && !vscode-commit.isGenerating && vscode-commit.hasStagedChanges",
          "icon": "$(robot)"
        },
        {
          "command": "vscode-commit.noOp",
          "group": "navigation@3",
          "when": "scmProvider == git && vscode-commit.isGenerating",
          "icon": "$(sync~spin)"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "build": "tsc -p ./",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node --import tsx node_modules/mocha/bin/mocha.js \"test/**/*.test.ts\"",
    "test:bdd": "cucumber-js",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^12.3.0",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.0",
    "@types/node": "^25.0.2",
    "@types/vscode": "^1.80.0",
    "@typescript-eslint/eslint-plugin": "^8.48.1",
    "@typescript-eslint/parser": "^8.48.1",
    "chai": "^6.2.2",
    "eslint": "^9.0.0",
    "mocha": "^11.7.5",
    "ts-node": "^10.9.0",
    "tsx": "^4.19.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {}
}
