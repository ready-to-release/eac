# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
null
nul
*.backup
*.bak
/test.md
/test-*.md
/test_*.md
temp_*.txt
*-example.yml
**.drawio.png.bkp
*.log

# Claude Code temporary files
tmpclaude-*-cwd

.claude/plans/*
.claude/plans/**

out/*
out/**
!out/.gitkeep

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Node.js (for VSCode extension)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
*.tsbuildinfo

# VSCode extension build artifacts
.vscode/extensions/*/out/
.vscode/extensions/*/node_modules/
.vscode/extensions/*/*.vsix
.vscode/extensions/*/.vscode-test/
.vscode/extensions/*/package.json
# VSCode extension build outputs (post-build copy destination)
.vscode/extensions/vscode-commit/

# TypeScript compiled output
typescript/*/out/

# env file
.env

# Editor/IDE
.idea/
# Keep .vscode/ for extension development but ignore build artifacts above

# Visual Studio
.vs/
*.sln
*.suo
*.user
*.userosscache
*.sln.docstates

# Claude Code local settings (personal preferences not shared with team)
.claude/settings.local.json

# VSCode local settings (API keys, personal config)
.vscode/settings.local.json

# MkDocs
site/
.cache/
!.cache/**/.gitkeep

# Auto-generated asset manifest cache (usage data, stats)
# The descriptions.yml file IS tracked (human-maintained descriptions)
docs/assets/.manifest-cache.json

# Structurizr (architecture diagrams)
# Generated files when running 'design serve'
.structurizr/
**/.design/workspace.json

# Generated embed files (created by go:generate, source is in .eac/)
go/eac/core/environments/repository/

# Docker
.docker/
docker-compose.override.yml
.vscode/settings.json

# CLIE CLI configuration and logs
.clie/*
!.clie/.gitkeep
!.clie/clie.yml

# EAC configuration (tracked separately)
# Personal overrides are gitignored
.eac/*.personal*

# User can optionally commit prompt customizations
.eac/prompts/
__pycache__/
main.py
**.mp4
